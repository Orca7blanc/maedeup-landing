{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maedeup-landing",
  "main": "src/seed-scene-break-wrapper.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "SOCIAL_AUTOMATION_ENABLED": "false",
    "SOCIAL_NOTION_DATA_SOURCE_ID": "c6f33305-fd39-43dc-9d27-37b073388be5"
  },

  "triggers": {
    "crons": ["* * * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/preview",
      "/preview.html",
      "/seed",
      "/seed/*",
      "/seed-api/*",
      "/episode/*",
      "/assets/*",
      "/_next/*",
      "/_vinext/*",
      "/seed-title-logo.png",
      "/og.png",
      "/favicon.svg",
      "/api/*",
      "/google1ff58ef5011b84c8.html",
      "/naver79299a37055c37ed312f92ef0e472ee2.html"
    ]
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maedeup-survivors",
      "database_id": "5181714d-2c44-4b43-860f-1388eea4023c"
    }
  ]
}
